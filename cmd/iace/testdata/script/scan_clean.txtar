# A compliant repository: findings section empty, summary on stdout, exit 0.
exec iace scan repo
stdout '^No findings\.$'
stdout '^Scanned 1 root module: \.$'
! stderr .

-- repo/main.tf --
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

resource "aws_instance" "web" {
  ami           = "ami-0123456789abcdef0"
  instance_type = "t3.micro"

  metadata_options {
    http_tokens = "required"
  }
}
