{
  "name": "release tags are immutable",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/tags/v*", "refs/tags/policies-v*"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "update" },
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ]
}
