{
  "terraform": {
    "required_providers": {
      "aws": {"source": "hashicorp/aws", "version": "~> 6.0"}
    }
  },
  "variable": {
    "http_tokens": {"type": "string"}
  },
  "resource": {
    "aws_instance": {
      "from_variable": {
        "ami": "ami-0123456789abcdef0",
        "instance_type": "t3.micro",
        "metadata_options": {"http_tokens": "${var.http_tokens}"}
      }
    }
  }
}
